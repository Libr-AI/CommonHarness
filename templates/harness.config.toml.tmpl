# harness.config.toml — per-project configuration for the harness governance protocol.
# Pin upstream version. `harness upgrade` uses this to decide what to fetch.
harness_version = "{{harness_version}}"

[verify]
# Language-agnostic. These are run at every "✋ Commit point".
format       = "{{verify_format}}"
format_check = "{{verify_format_check}}"
test         = "{{verify_test}}"

[paths]
# Triage: edits inside any of these dirs trigger the FULL path (vs light path).
forbidden_without_brief = {{paths_forbidden_toml_array}}
# Triage: spanning 2+ of these counts as cross-cutting.
cross_cutting           = {{paths_cross_cutting_toml_array}}
architecture_doc        = "{{paths_architecture_doc}}"
# Spec gate: standalone design specs land here when the coordinator decides
# a task needs one (see .harness/triage.md → Spec gate).
spec_dir                = "{{paths_spec_dir}}"

[branch]
feature_prefix = "{{branch_feature_prefix}}"
main_branch    = "{{branch_main}}"
dev_branch     = "{{branch_dev}}"

[integrations]
claude_code = {{int_claude_code}}
cursor      = {{int_cursor}}
codex_mcp   = {{int_codex_mcp}}
github_pr   = {{int_github_pr}}

[collaboration]
# "" = unset → the coordinator confirms solo/team on first `harness start`.
# "solo" = single developer (default behavior). "team" = multiple developers
# with concurrent tasks; `harness status` shows the team view of active briefs.
# CURRENT.md is per-clone local state in BOTH modes (it is git-ignored).
mode = "{{collaboration_mode}}"

[language]
# Conversation language always mirrors the user ("auto"). `artifacts` is the
# language for files written into the repo (specs, briefs, docs). "" = unset →
# confirmed on first artifact write; thereafter a BCP-47 code, e.g. "en" / "zh-CN".
conversation = "auto"
artifacts    = "{{language_artifacts}}"

[adoption]
# Brownfield onboarding. "auto" = on the first `harness start`, the coordinator
# looks for prior agent memory about this project — in the repo AND in your
# user-level store for this project (Claude Code's ~/.claude/projects/<repo>,
# Codex/Cursor session stores) — and, only if it finds some, asks which source
# to import and distils it into .harness/MEMORY.md (+ relocate architecture doc,
# rebuild history into archive/, reconcile same-name conflicts). "off" = never.
on_init = "{{adoption_on_init}}"

[architecture]
# The project map at paths.architecture_doc is a GLOBAL read basis: every
# session (coordinator, implementer, Cursor rule, SessionStart hook) loads it.
# `provided` records the scaffold-time choice — "" = unset (asked when a
# scaffold task starts); "yes" = a doc is/will be supplied; "no" = opted out.
provided     = "{{architecture_provided}}"
global_basis = {{architecture_global_basis}}

[skills]
# At task close-out, "auto" = the implementer evaluates whether the finished
# task produced a reusable, generalisable procedure worth distilling into a
# tool-agnostic skill at .harness/skills/<name>/SKILL.md, and — only if there's
# a high-value candidate — proposes it for you to accept. "off" = never propose.
distill = "{{skills_distill}}"

[presets]
preset = "{{preset}}"
